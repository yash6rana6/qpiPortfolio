# --- Database (free: MongoDB Atlas M0) ---
MONGODB_URI=your_mongodb_atlas_connection_string
# MONGO_POOL_SIZE=50

# --- Redis (seat locks, cache, queue, live updates) ---
# Local:  docker compose up -d redis      -> redis://127.0.0.1:6379
# Cloud:  Redis Cloud free 30MB           -> rediss://default:PASSWORD@HOST:PORT
REDIS_URL=redis://127.0.0.1:6379
# Seconds a seat stays locked while the user pays (default 300 = 5 min)
# SEAT_HOLD_SECONDS=300
# Set to false on web-only instances if workers run elsewhere
# ENABLE_WORKER=true
# WORKER_CONCURRENCY=20

# --- Auth ---
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- Payments (free: Razorpay test mode) ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Dashboard -> Webhooks -> secret you choose. URL: /api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=choose_a_webhook_secret

# --- Admin seed (used only by `npm run seed`) ---
SEED_ADMIN_NAME=Yash
SEED_ADMIN_EMAIL=admin@qpie.test
SEED_ADMIN_PASSWORD=change_this_password

# --- Optional ---
# Origin allowed to call /api/v1 from outside the browser app (mobile, etc.)
# ALLOWED_ORIGIN=https://app.qpie.in
